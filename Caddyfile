# i9Hub SaaS - Caddy Reverse Proxy com TLS automático
# Substitua {DOMAIN} pelo domínio real antes do deploy

{DOMAIN} {
    reverse_proxy i9hub-app:3000

    # Headers de segurança
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
        Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
        -Server
    }

    # Compressão
    encode gzip zstd

    # Logs
    log {
        output stdout
        format console
    }
}