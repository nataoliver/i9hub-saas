# i9Hub SaaS - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores antes do deploy

# ─── Banco de Dados ───
POSTGRES_USER=i9hub
POSTGRES_PASSWORD=mude_esta_senha_em_producao_2026
POSTGRES_DB=i9hub_saas

# ─── Segurança ───
JWT_SECRET=gerar_com_openssl_rand_hex_32
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ─── WhatsApp Gateway (Evolution API) ───
WA_GATEWAY_PUBLIC_URL=https://seu-dominio.com/wa
WA_GATEWAY_API_KEY=gerar_chave_api_segura_aqui

# ─── IA Multi-Modelo ───
DEEPSEEK_API_KEY=sk-deepseek-sua-chave-aqui
ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# ─── Domínio (Caddy TLS automático) ───
DOMAIN=seu-dominio.com

# ─── Rate Limiting por Plano (req/min) ───
RATE_LIMIT_BASIC=100
RATE_LIMIT_PRO=500
RATE_LIMIT_ENTERPRISE=2000

# ─── Pool PostgreSQL ───
PG_POOL_MIN=2
PG_POOL_MAX=20

# ─── Redis (BullMQ) ───
REDIS_URL=redis://redis:6379/0

# ─── Worker ───
WORKER_CONCURRENCY=5

# ─── Painel de Licenças ───
LICENSE_API_URL=https://licencas.seudominio.com/api/v1/validate
LICENSE_API_KEY=chave_interna_do_painel_de_licencas