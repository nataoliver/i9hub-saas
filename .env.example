# --- Traefik Dashboard Auth ---
TRAEFIK_DASHBOARD_AUTH=admin:$$apr1$$H6uskkkW$$IgXLP6ewTrSuBkVuq8y7s.

# --- Rate Limiting por Plano (req/min) ---
